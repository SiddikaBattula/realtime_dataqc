# Copy to .env and fill in. .env is gitignored - it holds live credentials.

# --- Database the agent reads from -------------------------------------
# Each well has its own MySQL host and database; the host and database name
# are supplied per well through POST /wells. These are the shared credentials
# used to connect to all of them.
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=ofiil

# The single-row table every well exposes its latest reading in.
TABLE_NAME=timebaselastrecord

# --- Agent behaviour ----------------------------------------------------
# Seconds between readings.
CHECK_INTERVAL=1

# Hole depth minus bit depth, in metres. At or below this the bit is on
# bottom and the activity is DRILLING; above it, NON DRILLING.
DRILLING_CRITERIA=0.1

# --- Config API ---------------------------------------------------------
CONFIG_API_HOST=0.0.0.0
CONFIG_API_PORT=8000

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_RETENTION_HOURS=24

# --- Alerts -------------------------------------------------------------
# Hours an alert is kept in output/<well>/alerts.json before it is removed.
ALERT_RETENTION_HOURS=24
