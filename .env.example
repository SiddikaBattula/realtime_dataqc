# Real-Time Data QC - every timing and limit the app runs on.
#
# Nothing below is hard-coded anywhere else: change a value here, restart, and
# that is the whole procedure. The dashboard reads its own settings from this
# file too, through GET /settings, so app.js never needs editing either.
#
# Every line is optional - leave one out and the default in brackets is used.

# ---- rig databases --------------------------------------------------------
DB_HOST=43.241.39.241
DB_PORT=8100
DB_USERNAME=root
DB_PASSWORD=ofiil
DB_NAME=mndwo181hdb_1(m

# The single-row table each rig exposes its latest reading in.
TABLE_NAME=timebaselastrecord

# ---- how often each well is read [1 / 5] ----------------------------------
# Seconds between readings, and seconds to wait before reconnecting after the
# loop hits an error.
CHECK_INTERVAL=1
RETRY_INTERVAL=5

# Seconds between the agent manager's passes: how long a well added in the
# dashboard waits to start, and how quickly a dead agent is restarted. [5]
AGENT_POLL_INTERVAL=5

# ---- knowing the agents are alive [60 / 120] ------------------------------
# Seconds between each well's "alive | reading | ..." line, and how long the
# rig may answer with an unchanged row before that line says STALE FEED.
HEARTBEAT_SECONDS=60
STALE_ROW_SECONDS=120

# ---- drilling ------------------------------------------------------------
# Metres off bottom a NEW well's form opens with. Each well keeps its own,
# edited in the dashboard - this is only the starting value. [0.1]
DEFAULT_DRILLING_CRITERIA=0.1

# ---- alerts on disk [24 / 60] ---------------------------------------------
# Hours an alert is kept in output/<well>/alerts.json, and seconds between the
# sweeps that remove the ones past it.
ALERT_RETENTION_HOURS=24
ALERT_PRUNE_INTERVAL=60

# How many alerts GET /alerts/{well} returns by default, and the most it will
# return however many are asked for. [200 / 5000]
ALERT_PAGE_DEFAULT=200
ALERT_PAGE_MAX=5000

# ---- logs [INFO / 24 / H / 1 / 60] ----------------------------------------
# What reaches the console (the files always take DEBUG), how many rolled files
# are kept, when they roll ("H" hourly, "D" daily), and the interval between
# rolls. 24 hourly files is a day of history.
LOG_LEVEL=INFO
LOG_RETENTION_HOURS=24
LOG_ROTATE_WHEN=H
LOG_ROTATE_INTERVAL=1

# Seconds before a set of alerts that has not changed is written out again.
LOG_REPEAT_SECONDS=60

# ---- the dashboard and its API [0.0.0.0 / 8000] ---------------------------
CONFIG_API_HOST=0.0.0.0
CONFIG_API_PORT=8000

# Seconds between the page's polls, and how long a new well keeps saying
# "starting" rather than "all clear". [5 / 8]
DASHBOARD_POLL_SECONDS=5
DASHBOARD_STARTING_SECONDS=8

# Minutes an alert stays on its card, and the most one card will hold. The
# alert stays in the file until ALERT_RETENTION_HOURS either way. [30 / 1000]
DASHBOARD_ALERT_MAX_AGE_MINUTES=30
DASHBOARD_ALERT_LIMIT=1000

# How far a card can be dragged: pixels of alert list, and grid columns.
# [90 / 900 / 4]
DASHBOARD_CARD_MIN_HEIGHT=90
DASHBOARD_CARD_MAX_HEIGHT=900
DASHBOARD_CARD_MAX_COLUMNS=4

# ---- working without a rig ------------------------------------------------
# Simulated readings from fake_rig.py, so the dashboard and the checks can be
# worked on while no rig is reachable. Nothing is read from any database while
# this is set - REMOVE IT once the rig answers again.
FAKE_RIG=1

DEFAULT_BD_THRESHOLD_DRILLING=0.01
DEFAULT_BD_THRESHOLD_NON_DRILLING=5

# ---- the ten-minute alert digest (see .env.example for what each does) ----
EMAIL_ENABLED=true
EMAIL_INTERVAL_SECONDS=60

# ofiindia.com is on Microsoft 365 - its MX is
# ofiindia-com.mail.protection.outlook.com - so this is the M365 relay.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USE_TLS=true

# Quoted because the password contains a '#', which an unquoted value would
# otherwise have treated as the start of a comment.
SMTP_USERNAME=Siddika@ofiindia.com
SMTP_PASSWORD='sidd#03022003'

# M365 will only accept a sender it has authenticated, so this is the mailbox
# above and not a made-up noreply@ address.
SMTP_FROM=Siddika@ofiindia.com
EMAIL_FROM_NAME=Real-Time Data QC
